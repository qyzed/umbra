# Токен бота от @BotFather. Никогда не коммитьте реальный токен в Git.
BOT_TOKEN=your_bot_token_here

# Юзернейм бота без «@» — используется для генерации персональных ссылок.
BOT_USERNAME=anononsad_bot

# Создатель проекта (упоминается в /about и /start).
CREATOR_NAME=Rin
CREATOR_URL=https://t.me/Rinbland

# Путь к файлу базы данных SQLite.
DB_PATH=umbra.db
